/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "upload-api-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-16",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],

	"env": {
		"dev": {
			"name": "dev-upload-worker",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			"kv_namespaces": [
				{
					"binding": "MULTIPART_UPLOADS_KV",
					"id": "915fe5d0a2a342baaf7d6f53ed85c286",
				},
			],
			"vars": {
				"AWS_DEFAULT_REGION": "us-west-000",
				"AWS_ENDPOINT": "https://fotoowl-dev-bucket-1.s3.us-west-000.backblazeb2.com",
				"AWS_S3_BUCKET": "fotoowl-dev-bucket-1",
				"API_HOST": "https://dev-api.fotoowl.ai",
				"API_USERNAME": "eece118d-83b7-4593-9b5a-481e64cd558d",
				"DOCS_USERNAME": "fotoowl",
				"SENTRY_DSN": "https://348f1cb31d3031c537e128d312859f9f@o4511415367434240.ingest.us.sentry.io/4511420593537024",
				"ENV": "dev",
			},
			// Secrets (set via `.dev.vars` for local dev, or `wrangler secret put` for deployed dev):
			// - AWS_ACCESS_KEY_ID
			// - AWS_SECRET_ACCESS_KEY
			// - API_PASSWORD
			// - DOCS_PASSWORD
		},
		"staging": {
			"name": "staging-upload-worker",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			"kv_namespaces": [
				{
					"binding": "MULTIPART_UPLOADS_KV",
					"id": "915fe5d0a2a342baaf7d6f53ed85c286",
				},
			],
			"vars": {
				"AWS_DEFAULT_REGION": "us-west-000",
				"AWS_ENDPOINT": "https://fotoowl-dev-bucket-1.s3.us-west-000.backblazeb2.com",
				"AWS_S3_BUCKET": "fotoowl-dev-bucket-1",
				"API_HOST": "https://staging-jiraya.fotoowl.ai",
				"API_USERNAME": "eece118d-83b7-4593-9b5a-481e64cd558d",
				"DOCS_USERNAME": "fotoowl",
				"SENTRY_DSN": "https://348f1cb31d3031c537e128d312859f9f@o4511415367434240.ingest.us.sentry.io/4511420593537024",
				"ENV": "staging",
				"OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "https://otel-staging.fotoowl.ai/v1/traces",
				"OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://otel-staging.fotoowl.ai/v1/logs",
				"OTEL_SERVICE_NAME": "upload-worker",
				"APP_OTEL_DEBUG": "true",
				"OTEL_DISABLE_TRACES": "true",
			},
			// Secrets (set via `.dev.vars` for local dev, or `wrangler secret put` for deployed dev):
			// - AWS_ACCESS_KEY_ID
			// - AWS_SECRET_ACCESS_KEY
			// - API_PASSWORD
			// - DOCS_PASSWORD
		},
		"prod": {
			"name": "prod-upload-worker",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA",
			},
			"kv_namespaces": [
				{
					"binding": "MULTIPART_UPLOADS_KV",
					"id": "REPLACE_WITH_PROD_MULTIPART_UPLOADS_KV_NAMESPACE_ID",
				},
			],
			"vars": {
				"AWS_DEFAULT_REGION": "us-west-000",
				"AWS_ACCESS_KEY_ID": "",
				"AWS_SECRET_ACCESS_KEY": "",
				"AWS_ENDPOINT": "",
				"AWS_S3_BUCKET": "",
				"API_HOST": "",
				"API_USERNAME": "",
				"API_PASSWORD": "",
				"DOCS_USERNAME": "",
				"DOCS_PASSWORD": "",
				"SENTRY_DSN": "",
				"ENV": "prod",
			},
			// Secrets (set via `wrangler secret put --env prod`):
			// - SENTRY_DSN (or set in vars above)
			// - AWS_ACCESS_KEY_ID
			// - AWS_SECRET_ACCESS_KEY
			// - API_PASSWORD
			// - DOCS_PASSWORD
		},
	},
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
